# ESP32-CAM Birdhouse Configuration

# Main task stack size (need extra for camera + ML)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768

# Camera configuration
CONFIG_CAMERA_TASK_STACK_SIZE=4096
CONFIG_CAMERA_CORE1=y

# PSRAM (required for ESP32-CAM frame buffers)
CONFIG_ESP32_SPIRAM_SUPPORT=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# WiFi
CONFIG_ESP_WIFI_SSID="changeme"
CONFIG_ESP_WIFI_PASSWORD="changeme"

# MQTT
CONFIG_MQTT_BUFFER_SIZE=4096
CONFIG_MQTT_TASK_STACK=8192

# Partition table - use large single app (3MB) for camera + MQTT firmware
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Increase HTTP buffer for image uploads
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y

# Power management
CONFIG_PM_ENABLE=y

# Watchdog - increase timeout for image processing
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
